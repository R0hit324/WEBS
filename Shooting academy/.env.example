# ============================================================
# Matsya Shooting Sports Academy - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials to source control
# ============================================================

# ------------------------------------------------------------
# SUPABASE (Database, Auth, Storage)
# ------------------------------------------------------------
# Get these from your Supabase Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key - ONLY for backend/edge functions
# NEVER expose this in frontend code (no VITE_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------
# RESEND (Email Service)
# ------------------------------------------------------------
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key-here

# Academy email address for receiving notifications
ACADEMY_EMAIL=info@matysashootingacademy.com

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
# Frontend URL (for CORS, email links, etc.)
VITE_APP_URL=https://matysashootingacademy.com

# Admin dashboard URL (if separate)
VITE_ADMIN_URL=https://admin.matysashootingacademy.com

# ------------------------------------------------------------
# OPTIONAL: Analytics, Monitoring
# ------------------------------------------------------------
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# SENTRY_DSN=https://xxx@sentry.io/xxx

# ------------------------------------------------------------
# DEVELOPMENT OVERRIDES (optional)
# ------------------------------------------------------------
# Uncomment and modify for local development
# VITE_SUPABASE_URL=http://localhost:54321
# VITE_SUPABASE_ANON_KEY=your-local-anon-key